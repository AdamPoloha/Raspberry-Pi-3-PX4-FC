#!/bin/sh
# PX4 commands need the 'px4-' prefix in bash.
# (px4-alias.sh is expected to be in the PATH)
. px4-alias.sh

param select parameters.bson
param import

# system_power not implemented
param set CBRK_SUPPLY_CHK 894281

param set-default BAT1_V_DIV 5.7

# broadcast to LAN
# always keep current config
param set SYS_AUTOCONFIG 1
# useless but required for parameter completeness
param set MAV_TYPE 1
param set SYS_AUTOSTART 2100

dataman start

load_mon start

battery_status start

# internal IMU
if ! mpu9250 start -s -b 0 -c 0
then
    echo "MPU9250 configuration failed, trying MPU6500..."
    mpu6500 start -s -b 0 -c 0
fi

# BARO
bmp280 start -I

# MAG
qmc5883p start -I

# ADC
#ads1115 start -I

# PWM
pca9685_pwm_out start -X
control_allocator start

# GPS
#gps start -d /dev/ttySC0 -i uart -p ubx -s

# Airspeed
#ms4525do start -X

#rc_input start -d /dev/ttyAMA0

#rc_update start
sensors start
commander start
navigator start
ekf2 start
#airspeed_selector start
land_detector start fixedwing
flight_mode_manager start
fw_att_control start
fw_mode_manager start
fw_lat_lon_control start

# Network Mavlink
mavlink start -x -u 14556 -r 1000000 -p

# Telemetry Mavlink
mavlink start -x -Z -d /dev/ttyUSB0 -b 115200

logger start -t -b 200

mavlink boot_complete

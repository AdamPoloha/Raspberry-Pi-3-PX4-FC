CONFIG_BOARD_TOOLCHAIN="aarch64-linux-gnu"
CONFIG_DRIVERS_IMU_INVENSENSE_MPU9250=y
CONFIG_DRIVERS_IMU_INVENSENSE_MPU6500=y
CONFIG_DRIVERS_BAROMETER_BMP280=y
CONFIG_DRIVERS_MAGNETOMETER_QMC5883P=y

CONFIG_EXAMPLES_FAKE_IMU=n
CONFIG_EXAMPLES_FAKE_MAGNETOMETER=n
CONFIG_EXAMPLES_DYN_HELLO=n
CONFIG_EXAMPLES_FAKE_GPS=n
CONFIG_EXAMPLES_HELLO=n
CONFIG_EXAMPLES_PX4_MAVLINK_DEBUG=n
CONFIG_EXAMPLES_PX4_SIMPLE_APP=n
CONFIG_EXAMPLES_WORK_ITEM=n
CONFIG_MODULES_SIMULATION_SIMULATOR_SIH=n
